' checks.bm - checkpoint printers. Each step's numbers, in a fixed format the
' Python oracle (export/oracle.py) can parse and compare.

SUB PrintModelInfo
    PRINT "weights.bin header"
    PRINT "  magic        "; cfg.magic
    PRINT "  version      "; cfg.version
    PRINT "  dim          "; cfg.modelDim
    PRINT "  hidden_dim   "; cfg.hiddenDim
    PRINT "  n_layers     "; cfg.nLayers
    PRINT "  n_heads      "; cfg.nHeads
    PRINT "  n_kv_heads   "; cfg.nKvHeads
    PRINT "  vocab_size   "; cfg.vocabSize
    PRINT "  seq_len      "; cfg.seqLen
    PRINT "  tied         "; cfg.tied
    PRINT "  rope_theta   "; cfg.ropeTheta
    PRINT "  rms_norm_eps "; cfg.rmsNormEps
    PRINT "  derived: head_dim ="; headDim; " kv_dim ="; kvDim; " kv_mul ="; kvMul
END SUB

' Step 1: first and last five floats of the file, with raw bytes.
SUB PrintWeightCheck
    DIM i AS LONG
    PRINT "first 5 floats of token_embedding (w(offTokenEmbedding + i)):"
    FOR i = 0 TO 4
        PRINT "  ["; i; "] "; CDBL(w(offTokenEmbedding + i)); "  hex "; FloatHex$(w(offTokenEmbedding + i))
    NEXT
    PRINT "last 5 floats of the file (tail of rms_final, w(nParams - 5 + i)):"
    FOR i = 0 TO 4
        PRINT "  ["; i; "] "; CDBL(w(nParams - 5 + i)); "  hex "; FloatHex$(w(nParams - 5 + i))
    NEXT
END SUB

' Step 2: the first few logits verbatim, then the k largest.
' Format: "logit <id> <value>" and "top <rank> id <id> logit <value>".
SUB PrintLogits (k AS LONG)
    DIM i AS LONG, r AS LONG, best AS LONG
    REDIM taken(0 TO cfg.vocabSize - 1) AS _BYTE
    FOR i = 0 TO 4
        PRINT "logit"; i; " "; logits(i)
    NEXT
    FOR r = 1 TO k
        best = -1
        FOR i = 0 TO cfg.vocabSize - 1
            IF taken(i) = 0 THEN
                IF best < 0 THEN
                    best = i
                ELSEIF logits(i) > logits(best) THEN
                    best = i
                END IF
            END IF
        NEXT
        taken(best) = 1
        PRINT "top"; r; " id"; best; " logit "; logits(best)
    NEXT
END SUB

' Step 3: each kernel once, in isolation, on real data from layer 0.
' Input is the (already verified) embedding row of a token. Every output
' element is printed with its raw bits so the oracle can compare exactly.
SUB KernelCheck (token AS LONG)
    DIM t0 AS DOUBLE, d AS LONG
    d = cfg.modelDim
    Embed token
    PrintVec "x", x(), d

    t0 = TIMER(0.001)
    RmsNorm xb(), x(), offRmsAtt(0), d
    PRINT "time rmsnorm"; TIMER(0.001) - t0
    PrintVec "rmsnorm", xb(), d

    t0 = TIMER(0.001)
    MatMul q(), xb(), offWq(0), d, d
    PRINT "time wq"; TIMER(0.001) - t0
    PrintVec "wq", q(), d

    t0 = TIMER(0.001)
    MatMul k(), xb(), offWk(0), d, kvDim
    PRINT "time wk"; TIMER(0.001) - t0
    PrintVec "wk", k(), kvDim

    t0 = TIMER(0.001)
    MatMul hb(), xb(), offW1(0), d, cfg.hiddenDim
    PRINT "time w1"; TIMER(0.001) - t0
    PrintVec "w1", hb(), cfg.hiddenDim
END SUB

' Format: "vec <name> <n>" then n lines "<i> <value> <hex>".
SUB PrintVec (label AS STRING, v() AS SINGLE, n AS LONG)
    DIM i AS LONG
    PRINT "vec "; label; n
    FOR i = 0 TO n - 1
        PRINT i; v(i); " "; FloatHex$(v(i))
    NEXT
END SUB

' Step 4: layer 0 over a short token sequence, token i at position i.
' Prints q and k of the last token after RoPE and the layer output at the
' last position. With one token attention is trivial (softmax of one score
' is 1, so the output is just v); with several, every piece of the layer
' matters, including the rotation making the scores depend on distance.
SUB LayerCheck (tokens() AS LONG, n AS LONG)
    DIM t0 AS DOUBLE, p AS LONG
    t0 = TIMER(0.001)
    FOR p = 0 TO n - 1
        Embed tokens(p)
        TransformerLayer 0, p
    NEXT
    PRINT "time layer"; TIMER(0.001) - t0; " for"; n; "positions"
    PrintVec "q_rope", q(), cfg.modelDim
    PrintVec "k_rope", k(), kvDim
    PrintVec "layer0", x(), cfg.modelDim
END SUB

' Step 7: show the pre-tokenizer chunks and the ids for one string.
SUB EncodeVerbose (text AS STRING)
    DIM c AS LONG, i AS LONG, n AS LONG, nChunks AS LONG
    REDIM chunkStart(0 TO 0) AS LONG, chunkLen(0 TO 0) AS LONG, ids(0 TO 0) AS LONG
    PreTokenize text, chunkStart(), chunkLen(), nChunks
    FOR c = 0 TO nChunks - 1
        PRINT "chunk "; CHR$(34); MID$(text, chunkStart(c), chunkLen(c)); CHR$(34)
    NEXT
    Encode text, ids(), n
    PRINT "ids:";
    FOR i = 0 TO n - 1
        PRINT ids(i);
    NEXT
    PRINT
    FOR i = 0 TO n - 1
        PRINT "  "; ids(i); " "; CHR$(34); tokStr(ids(i)); CHR$(34)
    NEXT
END SUB
