' tokenizer.bm - byte-level BPE, the way SmolLM2's (GPT-2 style) tokenizer
' does it, loaded straight from tokenizer.json. oracle/bpe_ref.py is the
' same algorithm in Python, validated against HuggingFace; keep them in sync.
'
' encode(text):
'   1. PreTokenize: split into chunks with the GPT-2 regex
'        's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+
'      written out as a scanner. Merges never cross a chunk boundary.
'   2. EncodeChunk: one token per byte, then repeatedly merge the adjacent
'      pair whose concatenation is a vocab token with the best score
'      (llama2.c's loop; score = -merge_rank, so lowest rank merges first).
'   3. bytes with no token (21 of them) are dropped, as HuggingFace does.

' ---------------------------------------------------------------------------
' LoadTokenizer: tokenizer.json -> tokStr(), tokScore(), byteId(), the hash
' table and the Unicode class ranges.
'
' The vocab in tokenizer.json is byte-level: every token is a string over
' GPT-2's 256-character alphabet, where each character stands for one byte
' (printable Latin-1 characters stand for themselves, the 68 others are
' mapped to U+0100 and up; a space is 'Ġ'). ByteLevelDecode$ turns such a
' string back into the raw bytes the engine works with.
'
' Scores emulate GPT-2's merge ranks for llama2.c's "merge the best-scoring
' adjacent pair" loop: the token produced by merge rule number r gets
' score -r, so the lowest rank wins as the highest score. Tokens no merge
' produces (byte tokens, specials) get -1e30 and are never merged into.
' ---------------------------------------------------------------------------
SUB LoadTokenizer (dir AS STRING)
    DIM root AS LONG, model AS LONG, vocab AS LONG, c AS LONG, id AS LONG, rank AS LONG
    DIM i AS LONG, m AS STRING, sp AS LONG, merged AS STRING
    root = JsonParse&(ReadFile$(dir + "/tokenizer.json"))
    model = JsonNeed&(root, "model")
    IF jValue(JsonNeed&(model, "type")) <> "BPE" THEN Fail "tokenizer model is not BPE"
    vocab = JsonNeed&(model, "vocab")
    tokVocabSize = jLen(vocab)
    REDIM tokStr(0 TO tokVocabSize - 1) AS STRING
    REDIM tokScore(0 TO tokVocabSize - 1) AS SINGLE
    FOR i = 0 TO tokVocabSize - 1
        tokScore(i) = -1E+30
    NEXT
    BuildByteLevelMap

    c = JsonFirst&(vocab)
    WHILE c >= 0
        id = JsonNum#(c)
        IF id < 0 OR id >= tokVocabSize THEN Fail "vocab id out of range:" + STR$(id)
        tokStr(id) = ByteLevelDecode$(jKey(c))
        c = JsonNext&(c)
    WEND
    ' added tokens (the specials) are literal text, not byte-level encoded
    c = JsonFirst&(JsonNeed&(root, "added_tokens"))
    WHILE c >= 0
        id = JsonNum#(JsonNeed&(c, "id"))
        tokStr(id) = jValue(JsonNeed&(c, "content"))
        c = JsonNext&(c)
    WEND

    ' lookup tables: byte -> id, and string -> id
    FOR i = 0 TO 255
        byteId(i) = -1
    NEXT
    FOR i = 0 TO HASH_MASK
        hashId(i) = -1
    NEXT
    tokMaxLen = 0
    FOR i = 0 TO tokVocabSize - 1
        IF LEN(tokStr(i)) = 1 THEN byteId(ASC(tokStr(i))) = i
        IF LEN(tokStr(i)) > tokMaxLen THEN tokMaxLen = LEN(tokStr(i))
        HashInsert tokStr(i), i
    NEXT

    ' merge rules, in rank order: "a b" strings (older files) or [a, b] pairs
    rank = 0
    c = JsonFirst&(JsonNeed&(model, "merges"))
    WHILE c >= 0
        IF jType(c) = JSON_ARRAY THEN
            merged = ByteLevelDecode$(jValue(JsonAt&(c, 0))) + ByteLevelDecode$(jValue(JsonAt&(c, 1)))
        ELSE
            m = jValue(c)
            sp = INSTR(m, " ")
            merged = ByteLevelDecode$(LEFT$(m, sp - 1)) + ByteLevelDecode$(MID$(m, sp + 1))
        END IF
        id = LookupId&(merged)
        IF id < 0 THEN Fail "merge result not in vocab: " + merged
        IF tokScore(id) = -1E+30 THEN tokScore(id) = -rank ' first rule producing a token wins
        rank = rank + 1
        c = JsonNext&(c)
    WEND

    LoadUnicodeRanges
END SUB

' GPT-2's byte -> unicode map, inverted: cpToByte(codepoint) = byte, or -1.
' Bytes 33..126, 161..172 and 174..255 map to themselves; the other 68 bytes
' map, in increasing order, to codepoints 256, 257, ...
SUB BuildByteLevelMap
    DIM b AS LONG, n AS LONG
    FOR b = 0 TO 323
        cpToByte(b) = -1
    NEXT
    n = 0
    FOR b = 0 TO 255
        IF (b >= 33 AND b <= 126) OR (b >= 161 AND b <= 172) OR (b >= 174 AND b <= 255) THEN
            cpToByte(b) = b
        ELSE
            cpToByte(256 + n) = b
            n = n + 1
        END IF
    NEXT
END SUB

' a vocab string (UTF-8 over the byte-level alphabet) -> the bytes it stands for
FUNCTION ByteLevelDecode$ (s AS STRING)
    DIM i AS LONG, cp AS LONG, decoded AS STRING
    decoded = ""
    i = 1
    WHILE i <= LEN(s)
        i = i + Utf8Next&(s, i, cp)
        IF cp > 323 THEN Fail "not a byte-level vocab string: " + s
        IF cpToByte(cp) < 0 THEN Fail "not a byte-level vocab string: " + s
        decoded = decoded + CHR$(cpToByte(cp))
    WEND
    ByteLevelDecode$ = decoded
END FUNCTION

' the \p{L}, \p{N}, \s tables from unicode.bm: "lo,hi,lo,hi,...," strings
SUB LoadUnicodeRanges
    nLetterRanges = ParseRanges&(UnicodeLetters$, letterLo(), letterHi())
    nNumberRanges = ParseRanges&(UnicodeNumbers$, numberLo(), numberHi())
    nSpaceRanges = ParseRanges&(UnicodeSpaces$, spaceLo(), spaceHi())
END SUB

' "65,90,97,122," -> lo() = 65, 97  hi() = 90, 122; returns the count
FUNCTION ParseRanges& (s AS STRING, lo() AS LONG, hi() AS LONG)
    DIM n AS LONG, i AS LONG, p AS LONG, q AS LONG
    n = 0
    FOR i = 1 TO LEN(s)
        IF ASC(s, i) = 44 THEN n = n + 1
    NEXT
    n = n \ 2
    REDIM lo(0 TO n - 1) AS LONG, hi(0 TO n - 1) AS LONG
    p = 1
    FOR i = 0 TO n - 1
        q = INSTR(p, s, ","): lo(i) = VAL(MID$(s, p, q - p)): p = q + 1
        q = INSTR(p, s, ","): hi(i) = VAL(MID$(s, p, q - p)): p = q + 1
    NEXT
    ParseRanges& = n
END FUNCTION

' ---------------------------------------------------------------------------
' string -> id hash table (FNV-1a, linear probing)
' ---------------------------------------------------------------------------
FUNCTION HashSlot& (s AS STRING)
    DIM h AS _UNSIGNED _INTEGER64, i AS LONG
    h = 2166136261
    FOR i = 1 TO LEN(s)
        h = (h XOR ASC(s, i)) * 16777619
        h = h AND &HFFFFFFFF&&
    NEXT
    HashSlot& = h AND HASH_MASK
END FUNCTION

SUB HashInsert (s AS STRING, id AS LONG)
    DIM slot AS LONG
    slot = HashSlot&(s)
    WHILE hashId(slot) >= 0
        IF tokStr(hashId(slot)) = s THEN Fail "duplicate token " + s
        slot = (slot + 1) AND HASH_MASK
    WEND
    hashId(slot) = id
END SUB

' id of the token whose bytes are exactly s, or -1
FUNCTION LookupId& (s AS STRING)
    DIM slot AS LONG
    slot = HashSlot&(s)
    WHILE hashId(slot) >= 0
        IF tokStr(hashId(slot)) = s THEN LookupId& = hashId(slot): EXIT FUNCTION
        slot = (slot + 1) AND HASH_MASK
    WEND
    LookupId& = -1
END FUNCTION

' ---------------------------------------------------------------------------
' UTF-8 and character classes
' ---------------------------------------------------------------------------
' Decode the codepoint starting at byte i of s. Returns its byte length and
' sets cp. Malformed input is treated as one byte per codepoint.
FUNCTION Utf8Next& (s AS STRING, i AS LONG, cp AS LONG)
    DIM b AS LONG, n AS LONG, j AS LONG
    b = ASC(s, i)
    IF b < 128 THEN
        cp = b: n = 1
    ELSEIF b >= 240 THEN
        cp = b AND 7: n = 4
    ELSEIF b >= 224 THEN
        cp = b AND 15: n = 3
    ELSEIF b >= 192 THEN
        cp = b AND 31: n = 2
    ELSE
        cp = b: n = 1 ' stray continuation byte
    END IF
    IF i + n - 1 > LEN(s) THEN cp = b: n = 1
    FOR j = 1 TO n - 1
        cp = cp * 64 + (ASC(s, i + j) AND 63)
    NEXT
    Utf8Next& = n
END FUNCTION

' binary search over sorted inclusive ranges
FUNCTION InRanges& (cp AS LONG, lo() AS LONG, hi() AS LONG, n AS LONG)
    DIM a AS LONG, b AS LONG, m AS LONG
    a = 0: b = n - 1
    WHILE a <= b
        m = (a + b) \ 2
        IF cp < lo(m) THEN
            b = m - 1
        ELSEIF cp > hi(m) THEN
            a = m + 1
        ELSE
            InRanges& = -1: EXIT FUNCTION
        END IF
    WEND
    InRanges& = 0
END FUNCTION

FUNCTION CharClass& (cp AS LONG)
    IF InRanges&(cp, spaceLo(), spaceHi(), nSpaceRanges) THEN CharClass& = CLS_SPACE: EXIT FUNCTION
    IF InRanges&(cp, letterLo(), letterHi(), nLetterRanges) THEN CharClass& = CLS_LETTER: EXIT FUNCTION
    IF InRanges&(cp, numberLo(), numberHi(), nNumberRanges) THEN CharClass& = CLS_NUMBER: EXIT FUNCTION
    CharClass& = CLS_OTHER
END FUNCTION

' ---------------------------------------------------------------------------
' 1. pre-tokenizer: text -> chunks (byte offsets into text)
' ---------------------------------------------------------------------------
' Fills chunkStart(c), chunkLen(c) for c = 0..nChunks-1.
SUB PreTokenize (text AS STRING, chunkStart() AS LONG, chunkLen() AS LONG, nChunks AS LONG)
    DIM n AS LONG, i AS LONG, j AS LONG, e AS LONG, k AS LONG, c AS LONG
    ' decode once: codepoint cp(k), its class cpClass(k), and byte offset cpPos(k); cpPos(n) = end
    n = 0
    REDIM cp(0 TO LEN(text)) AS LONG, cpClass(0 TO LEN(text)) AS LONG, cpPos(0 TO LEN(text)) AS LONG
    i = 1
    WHILE i <= LEN(text)
        cpPos(n) = i
        i = i + Utf8Next&(text, i, cp(n))
        cpClass(n) = CharClass&(cp(n))
        n = n + 1
    WEND
    cpPos(n) = LEN(text) + 1

    REDIM chunkStart(0 TO n) AS LONG, chunkLen(0 TO n) AS LONG
    nChunks = 0
    i = 0
    WHILE i < n
        e = -1
        ' 's|'t|'re|'ve|'m|'ll|'d  (lowercase only, tried first)
        IF cp(i) = 39 AND i + 1 < n THEN
            c = cp(i + 1)
            IF c = 115 OR c = 116 OR c = 109 OR c = 100 THEN ' s t m d
                e = i + 2
            ELSEIF i + 2 < n THEN
                IF (c = 114 AND cp(i + 2) = 101) OR (c = 118 AND cp(i + 2) = 101) OR (c = 108 AND cp(i + 2) = 108) THEN e = i + 3 ' re ve ll
            END IF
        END IF
        ' ' ?\p{L}+' | ' ?\p{N}+' | ' ?[^\s\p{L}\p{N}]+'   (optional literal space, then a run of one class)
        IF e < 0 THEN
            j = i
            IF cp(i) = 32 THEN j = i + 1
            IF j < n THEN
                k = cpClass(j)
                IF k <> CLS_SPACE THEN
                    e = j
                    WHILE e < n AND cpClass(e) = k
                        e = e + 1
                    WEND
                END IF
            END IF
        END IF
        ' '\s+(?!\S)' | '\s+'   (a run of whitespace; leave the last one for the next word)
        IF e < 0 THEN
            IF cpClass(i) = CLS_SPACE THEN
                e = i
                WHILE e < n AND cpClass(e) = CLS_SPACE
                    e = e + 1
                WEND
                IF e < n AND e - i > 1 THEN e = e - 1
            END IF
        END IF
        IF e < 0 THEN Fail "pre-tokenizer stuck at codepoint" + STR$(cp(i))
        chunkStart(nChunks) = cpPos(i)
        chunkLen(nChunks) = cpPos(e) - cpPos(i)
        nChunks = nChunks + 1
        i = e
    WEND
END SUB

' ---------------------------------------------------------------------------
' 2. byte-pair merging within one chunk. Appends ids to ids(), advances nIds.
' ---------------------------------------------------------------------------
SUB EncodeChunk (chunk AS STRING, ids() AS LONG, nIds AS LONG)
    DIM i AS LONG, m AS LONG, id AS LONG, best AS SINGLE, bestId AS LONG, bestAt AS LONG
    REDIM part(0 TO LEN(chunk)) AS LONG
    m = 0
    FOR i = 1 TO LEN(chunk) ' one token per byte; bytes without a token are dropped
        id = byteId(ASC(chunk, i))
        IF id >= 0 THEN part(m) = id: m = m + 1
    NEXT
    WHILE m > 1
        best = -1E+31: bestAt = -1
        FOR i = 0 TO m - 2
            id = LookupId&(tokStr(part(i)) + tokStr(part(i + 1)))
            IF id >= 0 THEN
                IF tokScore(id) > best THEN best = tokScore(id): bestId = id: bestAt = i
            END IF
        NEXT
        IF bestAt < 0 THEN EXIT WHILE ' nothing left to merge
        part(bestAt) = bestId
        FOR i = bestAt + 1 TO m - 2
            part(i) = part(i + 1)
        NEXT
        m = m - 1
    WEND
    FOR i = 0 TO m - 1
        ids(nIds) = part(i)
        nIds = nIds + 1
    NEXT
END SUB

' text -> ids(0..nIds-1). ids() is resized to fit.
SUB Encode (text AS STRING, ids() AS LONG, nIds AS LONG)
    DIM c AS LONG, nChunks AS LONG
    REDIM chunkStart(0 TO 0) AS LONG, chunkLen(0 TO 0) AS LONG
    REDIM ids(0 TO LEN(text)) AS LONG ' at most one token per byte
    nIds = 0
    PreTokenize text, chunkStart(), chunkLen(), nChunks
    FOR c = 0 TO nChunks - 1
        EncodeChunk MID$(text, chunkStart(c), chunkLen(c)), ids(), nIds
    NEXT
END SUB

FUNCTION Decode$ (ids() AS LONG, nIds AS LONG)
    DIM i AS LONG, s AS STRING
    s = ""
    FOR i = 0 TO nIds - 1
        IF ids(i) < 0 OR ids(i) >= tokVocabSize THEN Fail "token id out of range: " + STR$(ids(i))
        s = s + tokStr(ids(i))
    NEXT
    Decode$ = s
END FUNCTION
