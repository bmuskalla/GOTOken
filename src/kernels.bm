' kernels.bm - the numeric building blocks. Each one mirrors a function in run.c.

' ---------------------------------------------------------------------------
' MatMul: xout(d) = W(d, n) * x(n), where W starts at w(woff) and is stored
' row-major [d, n]. Same signature as run.c's matmul(xout, x, w, n, d) with
' the float* replaced by an offset into w().
'
' By FLOPs this loop is essentially the entire inference engine. The inner
' loop walks w() contiguously: row i of W is the n floats starting at
' woff + i * n. Formal verification against Python on fixed inputs, and the
' question of what "match" means for fp32 sums, is step 3.
' ---------------------------------------------------------------------------
SUB MatMul (xout() AS SINGLE, x() AS SINGLE, woff AS LONG, n AS LONG, d AS LONG)
    DIM i AS LONG, j AS LONG, rowStart AS LONG, acc AS SINGLE
    FOR i = 0 TO d - 1
        rowStart = woff + i * n
        acc = 0
        FOR j = 0 TO n - 1
            acc = acc + w(rowStart + j) * x(j)
        NEXT
        xout(i) = acc
    NEXT
END SUB

' ---------------------------------------------------------------------------
' RmsNorm: o = weight * x / rms(x), with rms(x) = sqrt(mean(x^2) + eps).
' run.c's rmsnorm(o, x, weight, size), eps taken from the header instead of
' being hardcoded. The weight is a per-element gain, [size] floats at woff.
'
' Pre-norm transformers apply this before attention and before the FFN so
' that whatever magnitude the residual stream has drifted to, the sublayer
' sees unit-scale input. No mean subtraction, unlike LayerNorm.
' ---------------------------------------------------------------------------
SUB RmsNorm (o() AS SINGLE, x() AS SINGLE, woff AS LONG, size AS LONG)
    DIM j AS LONG, ss AS SINGLE
    ss = 0
    FOR j = 0 TO size - 1
        ss = ss + x(j) * x(j)
    NEXT
    ss = ss / size
    ss = ss + cfg.rmsNormEps
    ss = 1 / SQR(ss)
    FOR j = 0 TO size - 1
        o(j) = w(woff + j) * (ss * x(j))
    NEXT
END SUB
